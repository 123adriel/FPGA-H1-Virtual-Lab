# 6. 4-bit Ripple Adder in H1L
DEVICE ADDER4
    INPUT A[4], B[4], CIN
    OUTPUT SUM[4], COUT

    WIRE C0, C1, C2

    # Bit 0
    LUT FA0_SUM(A[0], B[0], CIN, 0) = 0x9696
    LUT FA0_COUT(A[0], B[0], CIN, 0) = 0xE8E8

    # Bit 1
    LUT FA1_SUM(A[1], B[1], FA0_COUT, 0) = 0x9696
    LUT FA1_COUT(A[1], B[1], FA0_COUT, 0) = 0xE8E8

    # Bit 2
    LUT FA2_SUM(A[2], B[2], FA1_COUT, 0) = 0x9696
    LUT FA2_COUT(A[2], B[2], FA1_COUT, 0) = 0xE8E8

    # Bit 3
    LUT FA3_SUM(A[3], B[3], FA2_COUT, 0) = 0x9696
    LUT FA3_COUT(A[3], B[3], FA2_COUT, 0) = 0xE8E8

    ASSIGN SUM[0] = FA0_SUM
    ASSIGN SUM[1] = FA1_SUM
    ASSIGN SUM[2] = FA2_SUM
    ASSIGN SUM[3] = FA3_SUM
    ASSIGN COUT   = FA3_COUT
END
